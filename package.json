{
  "name": "business-english-materials",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && npm test && npm run build && wrangler deploy"
  },
  "dependencies": { "astro": "7.4.7" },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "~5.9.3",
    "wrangler": "4.158.0"
  }
}
