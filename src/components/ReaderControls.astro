<div class="reader-controls">
  <fieldset class="role-switch" disabled>
    <legend class="sr-only">Reading role</legend>
    <label><input type="radio" name="reading-role" value="student" checked /><span>Student</span></label>
    <label><input type="radio" name="reading-role" value="teacher" /><span>Teacher</span></label>
  </fieldset>
  <button class="copy-link" type="button" disabled>
    <svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true" fill="none"><rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M12 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.4"/></svg>
    <span data-copy-label>Copy student link</span>
  </button>
  <span class="sr-only" role="status" data-copy-status></span>
  <div class="copy-fallback" hidden>
    <label for="share-url">Copy this link</label>
    <input id="share-url" type="url" readonly aria-describedby="copy-help" />
    <p id="copy-help">Automatic copying is unavailable. Select and copy the URL above.</p>
  </div>
</div>

<script>
  import '../scripts/reader-mode';
</script>
